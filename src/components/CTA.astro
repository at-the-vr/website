---
type Props = {
  url: string;
  text: string;
  ext?: boolean;
};

const { url = "/", text = "Click here", ext = true } = Astro.props;

const relAtt = ext ? "noopener noreferrer" : undefined;
---

<section>
  <div class="mx-auto max-w-7xl border-x border-white/20">
    <div class="group hover:bg-primary duration-200">
      <a
        href={url}
        rel={relAtt}
        class="hover:rounded-0 bg-primary inline-flex w-full items-center justify-center rounded-full px-4 py-6 text-center text-3xl font-medium duration-200 hover:text-black focus:ring-0 lg:py-12 lg:text-6xl"
        >{text}</a
      >
    </div>
  </div>
</section>
